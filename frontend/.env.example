# Firebase Web App Configuration Example
# Copy this file to .env.local and populate with your Firebase credentials:
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Set to true for local development passwordless email login (no Firebase emails needed):
VITE_LOCAL_EMAIL_LOGIN=true
