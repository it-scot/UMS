{
  "name": "ums-firestore-setup",
  "private": true,
  "type": "module",
  "scripts": {
    "db:import": "node scripts/import-firestore.mjs",
    "backend": "mvn -f backend/pom.xml spring-boot:run",
    "frontend": "npm run dev --prefix frontend",
    "emulator": "firebase emulators:start --only firestore --import=./emulator-data --export-on-exit=./emulator-data",
    "emulator:import": "set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080&& node scripts/import-firestore.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
